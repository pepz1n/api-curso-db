POSTGRES_DB=api_tarefas
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=troque-esta-senha
TOKEN_KEY=troque-esta-chave-secreta

# Porta pública do Nginx (http://IP_PUBLICO/)
HTTP_PORT=80
# Porta da API direto, sem passar pelo Nginx (só acessível de dentro do servidor)
API_PORT_HOST=3000
# Porta do banco no servidor (só acessível de dentro da EC2)
DB_PORT_HOST=5432
